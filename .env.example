# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM model string. Default: gemini-flash-lite-latest (higher free-tier limits).
# gemini/gemini-flash-latest is stronger but its free tier allows only ~20 requests/day.
# Avoid Gemini 2.5 models (being shut down).
MODEL=gemini/gemini-flash-lite-latest

# Optional: where saved notes are stored (default: data/notes.json)
# NOTES_PATH=data/notes.json
