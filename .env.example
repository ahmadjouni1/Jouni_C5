# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM model string. Avoid Gemini 2.5 models (being shut down).
MODEL=gemini/gemini-flash-latest

# Optional: where saved notes are stored (default: data/notes.json)
# NOTES_PATH=data/notes.json
